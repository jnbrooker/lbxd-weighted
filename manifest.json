{
  "manifest_version": 3,
  "name": "Letterboxd Weighted Stats",
  "version": "0.2.0",
  "description": "Advanced Letterboxd stats: rater-normalised scores, taste-aware out-of-character ratings, friend predictions and recommendations.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://letterboxd.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://letterboxd.com/film/*"
      ],
      "js": [
        "src/lib/stats.js",
        "src/lib/letterboxd.js",
        "src/lib/recommend.js",
        "src/ui/util.js",
        "src/ui/film-tab.js",
        "src/ui/friends-tab.js",
        "src/ui/foryou-tab.js",
        "src/content.js"
      ],
      "css": [
        "src/panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "Letterboxd Weighted Stats — options"
  },
  "background": {
    "service_worker": "src/background.js"
  }
}
